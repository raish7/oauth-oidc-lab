# Copy to .env and fill in. Never commit .env.

# Signs the short-lived oauth_pending cookie. At least 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Fernet key used to encrypt access and refresh tokens at rest in the sessions table.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# Postgres from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5434/oauth_lab

# Where the browser app lives. Used for CORS (exact origin) and the post-login redirect.
FRONTEND_ORIGIN=http://localhost:3000

# This service's own origin. Used to build redirect URIs such as /auth/google/callback.
BFF_ORIGIN=http://localhost:8000

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must be exactly: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
